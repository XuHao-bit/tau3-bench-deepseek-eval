# OpenAI-compatible endpoint used by both the agent and the user simulator.
# The original evaluation used a private gateway; replace this with an endpoint
# that serves the same model IDs if you have access.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
# The OpenAI SDK (used by the dense embedder) reads OPENAI_BASE_URL.
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: separate endpoint/key for the GPT-5.2 user simulator.
# USER_API_BASE=https://your-user-simulator-endpoint/v1
# USER_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# Optional: official DeepSeek API instead of the OpenAI-compatible gateway.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE=https://api.deepseek.com
